generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id        Int      @id @default(autoincrement())
  title     String
  fileName  String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}